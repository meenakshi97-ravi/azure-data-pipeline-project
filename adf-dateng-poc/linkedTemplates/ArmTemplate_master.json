{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-dateng-poc"
		},
		"LinkedService_http_nyc_opendata_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://data.cityofnewyork.us"
		},
		"LinkedService_stacdateng01_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stacdateng01.dfs.core.windows.net/"
		},
		"LinkedServices_rest_nyc_opendata_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://data.cityofnewyork.us"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-dateng-poc_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LinkedService_http_nyc_opendata_properties_typeProperties_url": {
						"value": "[parameters('LinkedService_http_nyc_opendata_properties_typeProperties_url')]"
					},
					"LinkedService_stacdateng01_properties_typeProperties_url": {
						"value": "[parameters('LinkedService_stacdateng01_properties_typeProperties_url')]"
					},
					"LinkedServices_rest_nyc_opendata_properties_typeProperties_url": {
						"value": "[parameters('LinkedServices_rest_nyc_opendata_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-dateng-poc_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-dateng-poc_ArmTemplate_0')]"
			]
		}
	]
}