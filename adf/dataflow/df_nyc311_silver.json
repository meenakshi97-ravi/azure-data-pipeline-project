{
	"name": "df_nyc311_silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_json_flat",
						"type": "DatasetReference"
					},
					"name": "srcBronze"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_parquet",
						"type": "DatasetReference"
					},
					"name": "sinkSilver"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_quarantine",
						"type": "DatasetReference"
					},
					"name": "sinkQuarantine"
				},
				{
					"dataset": {
						"referenceName": "ds_dq_issues",
						"type": "DatasetReference"
					},
					"name": "sinkDqIssues"
				}
			],
			"transformations": [
				{
					"name": "selCols"
				},
				{
					"name": "castTypes"
				},
				{
					"name": "dedupe"
				},
				{
					"name": "latestOnly"
				},
				{
					"name": "selFinal"
				},
				{
					"name": "splitKey"
				},
				{
					"name": "dqFlags"
				},
				{
					"name": "dqfix"
				},
				{
					"name": "onlyIssues"
				},
				{
					"name": "selIssues"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {:@computed_region_92fq_4b7q} as short,",
				"          {:@computed_region_f5dn_yrer} as short,",
				"          {:@computed_region_sbqj_enih} as short,",
				"          {:@computed_region_yeji_bk3q} as short,",
				"          {:created_at} as string,",
				"          {:id} as string,",
				"          {:updated_at} as string,",
				"          {:version} as string,",
				"          address_type as string,",
				"          agency as string,",
				"          agency_name as string,",
				"          bbl as long,",
				"          borough as string,",
				"          bridge_highway_direction as string,",
				"          bridge_highway_name as string,",
				"          bridge_highway_segment as string,",
				"          city as string,",
				"          closed_date as string,",
				"          community_board as string,",
				"          complaint_type as string,",
				"          council_district as short,",
				"          created_date as string,",
				"          cross_street_1 as string,",
				"          cross_street_2 as string,",
				"          descriptor as string,",
				"          descriptor_2 as string,",
				"          due_date as string,",
				"          facility_type as string,",
				"          incident_address as string,",
				"          incident_zip as short,",
				"          intersection_street_1 as string,",
				"          intersection_street_2 as string,",
				"          landmark as string,",
				"          latitude as double,",
				"          location as (coordinates as double[], type as string),",
				"          location_type as string,",
				"          longitude as double,",
				"          open_data_channel_type as string,",
				"          park_borough as string,",
				"          park_facility_name as string,",
				"          police_precinct as string,",
				"          resolution_action_updated_date as string,",
				"          resolution_description as string,",
				"          road_ramp as string,",
				"          status as string,",
				"          street_name as string,",
				"          taxi_company_borough as string,",
				"          taxi_pick_up_location as string,",
				"          unique_key as integer,",
				"          vehicle_type as string,",
				"          x_coordinate_state_plane as integer,",
				"          y_coordinate_state_plane as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine',",
				"     wildcardPaths:['nyc311/*/*/part-*.json']) ~> srcBronze",
				"srcBronze select(mapColumn(",
				"          updated_at = {:updated_at},",
				"          row_id = {:id},",
				"          each(match(!startsWith(name,':')&&name!='location'))",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selCols",
				"selCols derive(unique_key = toLong(unique_key),",
				"          created_date = toTimestamp(created_date, 'yyyy-MM-dd\\'T\\'HH:mm:ss.SSS'),",
				"          closed_date = toTimestamp(closed_date, 'yyyy-MM-dd\\'T\\'HH:mm:ss.SSS'),",
				"          due_date = toTimestamp(due_date, 'yyyy-MM-dd\\'T\\'HH:mm:ss.SSS'),",
				"          resolution_action_updated_date = toTimestamp(resolution_action_updated_date, 'yyyy-MM-dd\\'T\\'HH:mm:ss.SSS'),",
				"          updated_at = toTimestamp(updated_at, 'yyyy-MM-dd\\'T\\'HH:mm:ss.SSSX'),",
				"          latitude = toDouble(latitude),",
				"          longitude = toDouble(longitude)) ~> castTypes",
				"splitKey@valid window(over(unique_key),",
				"     desc(updated_at, true),",
				"     rn = rowNumber()) ~> dedupe",
				"dedupe filter(rn == 1) ~> latestOnly",
				"dqfix select(mapColumn(",
				"          each(match(name!='rn'))",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selFinal",
				"castTypes split(isNull(unique_key),",
				"     disjoint: false) ~> splitKey@(rejected, valid)",
				"latestOnly derive(closed_date_original = closed_date,",
				"          dq_future_closed = !isNull(closed_date) && closed_date > currentTimestamp(),",
				"          dq_closed_before_created = !isNull(closed_date) && !isNull(created_date) && closed_date < created_date,",
				"          dq_bad_coords = isNull(latitude) || isNull(longitude) || latitude < 40.4 || latitude > 41.0 || longitude < -74.3 || longitude > -73.6) ~> dqFlags",
				"dqFlags derive(closed_date = iif(dq_future_closed || dq_closed_before_created, toTimestamp(null()), closed_date)) ~> dqfix",
				"dqFlags filter(dq_future_closed || dq_closed_before_created || dq_bad_coords) ~> onlyIssues",
				"onlyIssues select(mapColumn(",
				"          unique_key,",
				"          created_date,",
				"          closed_date_original,",
				"          agency,",
				"          dq_future_closed,",
				"          dq_closed_before_created,",
				"          dq_bad_coords",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selIssues",
				"selFinal sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     truncate: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('roundRobin', 5)) ~> sinkSilver",
				"splitKey@rejected sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          address_type as string,",
				"          agency as string,",
				"          agency_name as string,",
				"          bbl as long,",
				"          borough as string,",
				"          bridge_highway_direction as string,",
				"          bridge_highway_name as string,",
				"          bridge_highway_segment as string,",
				"          city as string,",
				"          closed_date as timestamp,",
				"          community_board as string,",
				"          complaint_type as string,",
				"          council_district as short,",
				"          created_date as timestamp,",
				"          cross_street_1 as string,",
				"          cross_street_2 as string,",
				"          descriptor as string,",
				"          descriptor_2 as string,",
				"          due_date as timestamp,",
				"          facility_type as string,",
				"          incident_address as string,",
				"          incident_zip as short,",
				"          intersection_street_1 as string,",
				"          intersection_street_2 as string,",
				"          landmark as string,",
				"          latitude as double,",
				"          location_type as string,",
				"          longitude as double,",
				"          open_data_channel_type as string,",
				"          park_borough as string,",
				"          park_facility_name as string,",
				"          police_precinct as string,",
				"          resolution_action_updated_date as timestamp,",
				"          resolution_description as string,",
				"          road_ramp as string,",
				"          status as string,",
				"          street_name as string,",
				"          taxi_company_borough as string,",
				"          taxi_pick_up_location as string,",
				"          unique_key as long,",
				"          vehicle_type as string,",
				"          x_coordinate_state_plane as integer,",
				"          y_coordinate_state_plane as integer,",
				"          updated_at as timestamp,",
				"          row_id as string",
				"     ),",
				"     format: 'parquet',",
				"     truncate: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sinkQuarantine",
				"selIssues sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          address_type as string,",
				"          agency as string,",
				"          agency_name as string,",
				"          bbl as long,",
				"          borough as string,",
				"          bridge_highway_direction as string,",
				"          bridge_highway_name as string,",
				"          bridge_highway_segment as string,",
				"          city as string,",
				"          closed_date as timestamp,",
				"          community_board as string,",
				"          complaint_type as string,",
				"          council_district as short,",
				"          created_date as timestamp,",
				"          cross_street_1 as string,",
				"          cross_street_2 as string,",
				"          descriptor as string,",
				"          descriptor_2 as string,",
				"          due_date as timestamp,",
				"          facility_type as string,",
				"          incident_address as string,",
				"          incident_zip as short,",
				"          intersection_street_1 as string,",
				"          intersection_street_2 as string,",
				"          landmark as string,",
				"          latitude as double,",
				"          location_type as string,",
				"          longitude as double,",
				"          open_data_channel_type as string,",
				"          park_borough as string,",
				"          park_facility_name as string,",
				"          police_precinct as string,",
				"          resolution_action_updated_date as timestamp,",
				"          resolution_description as string,",
				"          road_ramp as string,",
				"          status as string,",
				"          street_name as string,",
				"          taxi_company_borough as string,",
				"          taxi_pick_up_location as string,",
				"          unique_key as long,",
				"          vehicle_type as string,",
				"          x_coordinate_state_plane as integer,",
				"          y_coordinate_state_plane as integer,",
				"          updated_at as timestamp,",
				"          row_id as string",
				"     ),",
				"     format: 'parquet',",
				"     truncate: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sinkDqIssues"
			]
		}
	}
}