{
	"name": "poc_nyc311_ingest",
	"properties": {
		"activities": [
			{
				"name": "Lookup config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_config_json",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Lookup state",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_state_json",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Build where clause",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup config",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Lookup state",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_where",
					"value": {
						"value": "@encodeUriComponent(concat('created_date >= ''', formatDateTime(addDays(utcNow(), mul(-1, int(activity('Lookup config').output.firstRow.sources[0].window_days))), 'yyyy-MM-dd'), 'T00:00:00''', ' AND :updated_at > ''', formatDateTime(addMinutes(activity('Lookup state').output.firstRow.last_watermark, mul(-1, int(activity('Lookup config').output.firstRow.sources[0].overlap_minutes))), 'yyyy-MM-ddTHH:mm:ss'), '.000Z'''))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Lookup count",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Build where clause",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_http_nyc311",
						"type": "DatasetReference",
						"parameters": {
							"relative_url": {
								"value": "@concat(activity('Lookup config').output.firstRow.sources[0].relative_url, '?$select=count(*)&$where=', variables('v_where'))",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Set page size",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_page_size",
					"value": {
						"value": "@string(activity('Lookup config').output.firstRow.sources[0].page_size)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set page count",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set page size",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_pages",
					"value": {
						"value": "@string(div(add(int(activity('Lookup count').output.firstRow.count), sub(int(variables('v_page_size')), 1)), int(variables('v_page_size'))))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach page",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Set page count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(0, int(variables('v_pages')))",
						"type": "Expression"
					},
					"batchCount": 4,
					"activities": [
						{
							"name": "Copy page to bronz",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_rest_nyc311",
									"type": "DatasetReference",
									"parameters": {
										"relative_url": {
											"value": "@concat(activity('Lookup config').output.firstRow.sources[0].relative_url, '?$select=:*,*&$where=', variables('v_where'), '&$order=:updated_at,:id&$limit=', variables('v_page_size'), '&$offset=', string(mul(item(), int(variables('v_page_size')))))",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_bronze_json",
									"type": "DatasetReference",
									"parameters": {
										"folder_path": {
											"value": "@concat('nyc311/ingest_date=', formatDateTime(utcNow(), 'yyyy-MM-dd'), '/run_id=', pipeline().RunId)",
											"type": "Expression"
										},
										"file_name": {
											"value": "@concat('part-', string(item()), '.json')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Update watermark",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "ForEach page",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"additionalColumns": [
							{
								"name": "last_watermark",
								"value": {
									"value": "@formatDateTime(pipeline().TriggerTime, 'yyyy-MM-ddTHH:mm:ss.fffZ')",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings",
							"filePattern": "setOfObjects"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['last_watermark']"
								},
								"sink": {
									"path": "last_watermark"
								}
							}
						],
						"collectionReference": ""
					}
				},
				"inputs": [
					{
						"referenceName": "ds_config_json",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_state_json",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Write audit row",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Update watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"additionalColumns": [
							{
								"name": "run_id",
								"value": {
									"value": "@pipeline().RunId",
									"type": "Expression"
								}
							},
							{
								"name": "source_id",
								"value": {
									"value": "@activity('Lookup config').output.firstRow.sources[0].source_id",
									"type": "Expression"
								}
							},
							{
								"name": "started_at",
								"value": {
									"value": "@pipeline().TriggerTime",
									"type": "Expression"
								}
							},
							{
								"name": "watermark_used",
								"value": {
									"value": "@activity('Lookup state').output.firstRow.last_watermark",
									"type": "Expression"
								}
							},
							{
								"name": "rows_expected",
								"value": {
									"value": "@activity('Lookup count').output.firstRow.count",
									"type": "Expression"
								}
							},
							{
								"name": "pages",
								"value": {
									"value": "@variables('v_pages')",
									"type": "Expression"
								}
							},
							{
								"name": "status",
								"value": {
									"value": "Succeeded",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['run_id']"
								},
								"sink": {
									"path": "run_id"
								}
							},
							{
								"source": {
									"path": "$['source_id']"
								},
								"sink": {
									"path": "source_id"
								}
							},
							{
								"source": {
									"path": "$['started_at']"
								},
								"sink": {
									"path": "started_at"
								}
							},
							{
								"source": {
									"path": "$['watermark_used']"
								},
								"sink": {
									"path": "watermark_used"
								}
							},
							{
								"source": {
									"path": "$['rows_expected']"
								},
								"sink": {
									"path": "rows_expected"
								}
							},
							{
								"source": {
									"path": "$['pages']"
								},
								"sink": {
									"path": "pages"
								}
							},
							{
								"source": {
									"path": "$['status']"
								},
								"sink": {
									"path": "status"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "ds_config_json",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_audit_json",
						"type": "DatasetReference",
						"parameters": {
							"file_name": {
								"value": "@concat(pipeline().RunId, '.json')",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"variables": {
			"v_where": {
				"type": "String"
			},
			"v_page_size": {
				"type": "String"
			},
			"v_pages": {
				"type": "String"
			}
		},
		"annotations": []
	}
}